
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="SkyRoute — İstanbul-Amsterdam uçuşlarını karşılaştır, sana en uygun seçeneği bul.">
    <title>İstanbul - Amsterdam Uçuşları | SkyRoute</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Google Fonts: Inter + Sora -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Özel stiller -->
    <link href="/css/flight-list.css" rel="stylesheet">
</head>
<body>

    <!-- =========================================================
         1. HEADER / NAVBAR (sticky, beyaz)
    ========================================================== -->
    <header>
        <nav class="navbar navbar-expand-lg sticky-top sr-navbar">
            <div class="container">
                <!-- Logo -> index.html -->
                <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
                    <span class="sr-logo-mark" aria-hidden="true"><i class="bi bi-send-fill"></i></span>
                    <span class="sr-logo-text">Sky<span class="sr-logo-accent">Route</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto mb-3 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="index.html#aramaPaneli">Uçuş Ara</a></li>
                        <li class="nav-item"><a class="nav-link" href="index.html#kampanyalar">Kampanyalar</a></li>
                        <li class="nav-item"><a class="nav-link" href="index.html#populerRotalar">Popüler Rotalar</a></li>
                        <li class="nav-item"><a class="nav-link" href="index.html#esnekSeyahat">Seyahat Rehberi</a></li>
                        <li class="nav-item"><a class="nav-link" href="#footer">Yardım</a></li>
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <select class="form-select form-select-sm sr-mini-select" aria-label="Para birimi">
                            <option value="TRY" selected>TRY ₺</option>
                            <option value="EUR">EUR €</option>
                            <option value="USD">USD $</option>
                            <option value="GBP">GBP £</option>
                        </select>
                        <select class="form-select form-select-sm sr-mini-select" aria-label="Dil">
                            <option value="tr" selected>TR</option>
                            <option value="en">EN</option>
                        </select>
                        <a href="#" class="btn btn-sr-login btn-sm"><i class="bi bi-person-circle me-1"></i>Giriş Yap</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- =========================================================
         2. ARAMA ÖZETİ ALANI
    ========================================================== -->
    <section class="sr-summary-bar">
        <div class="container">
            <div class="sr-summary-wrap">
                <!-- Özet kutucukları -->
                <div class="sr-summary-chips">
                    <div class="sr-chip sr-chip-route">
                        <i class="bi bi-airplane"></i>
                        <span id="sumRoute">İstanbul <b>IST</b> → Amsterdam <b>AMS</b></span>
                    </div>
                    <div class="sr-chip"><i class="bi bi-calendar-event"></i><span id="sumDates">18 Ağu 2026 – 24 Ağu 2026</span></div>
                    <div class="sr-chip"><i class="bi bi-people"></i><span id="sumPax">1 Yetişkin</span></div>
                    <div class="sr-chip"><i class="bi bi-briefcase"></i><span id="sumCabin">Ekonomi</span></div>
                    <div class="sr-chip"><i class="bi bi-arrow-left-right"></i><span id="sumTrip">Gidiş-Dönüş</span></div>
                </div>

                <!-- Aramayı değiştir butonu -->
                <button class="btn btn-sr-edit" type="button" data-bs-toggle="collapse" data-bs-target="#editSearch"
                        aria-expanded="false" aria-controls="editSearch">
                    <i class="bi bi-pencil-square me-1"></i>Aramayı Değiştir
                </button>
            </div>

            <!-- Aramayı değiştir paneli (collapse) -->
            <div class="collapse" id="editSearch">
                <div class="sr-edit-panel">
                    <div class="row g-3 align-items-end">
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edFrom">Kalkış</label>
                            <input type="text" class="form-control sr-input" id="edFrom" value="İstanbul, IST">
                        </div>
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edTo">Varış</label>
                            <input type="text" class="form-control sr-input" id="edTo" value="Amsterdam, AMS">
                        </div>
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edDepart">Gidiş</label>
                            <input type="date" class="form-control sr-input" id="edDepart" value="2026-08-18">
                        </div>
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edReturn">Dönüş</label>
                            <input type="date" class="form-control sr-input" id="edReturn" value="2026-08-24">
                        </div>
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edPax">Yolcu</label>
                            <select class="form-select sr-input" id="edPax">
                                <option value="1">1 Yetişkin</option>
                                <option value="2">2 Yetişkin</option>
                                <option value="3">3 Yetişkin</option>
                                <option value="4">4 Yetişkin</option>
                            </select>
                        </div>
                        <div class="col-6 col-lg-2">
                            <label class="sr-label" for="edCabin">Kabin</label>
                            <select class="form-select sr-input" id="edCabin">
                                <option value="Ekonomi" selected>Ekonomi</option>
                                <option value="Premium Ekonomi">Premium Ekonomi</option>
                                <option value="Business">Business</option>
                                <option value="First Class">First Class</option>
                            </select>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn btn-sr-primary" id="updateSearchBtn"><i class="bi bi-arrow-repeat me-1"></i>Uçuşları Güncelle</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         3. SAYFA BAŞLIĞI + SONUÇ BİLGİSİ + SIRALAMA
    ========================================================== -->
    <div class="container">
        <div class="sr-result-head">
            <div>
                <h1 class="sr-result-title" id="resultTitle">İstanbul - Amsterdam Uçuşları</h1>
                <p class="sr-result-count" id="resultCount">10 uçuş seçeneği bulundu</p>
            </div>
            <div class="sr-sort-wrap">
                <label class="sr-sort-label" for="sortSelect">Sırala:</label>
                <select class="form-select sr-input sr-sort-select" id="sortSelect">
                    <option value="recommended" selected>Önerilen</option>
                    <option value="price">En Düşük Fiyat</option>
                    <option value="duration">En Kısa Süre</option>
                    <option value="earliest">En Erken Kalkış</option>
                    <option value="latest">En Geç Kalkış</option>
                </select>
            </div>
        </div>

        <!-- Mobil filtre butonu -->
        <button class="btn btn-sr-filter-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
            <i class="bi bi-sliders me-1"></i>Filtrele
        </button>
    </div>

    <!-- =========================================================
         4. ANA DÜZEN: filtre (sol) + sonuçlar (sağ)
    ========================================================== -->
    <main class="container sr-main">
        <div class="row g-4">

            <!-- ==================== FİLTRE (masaüstü) ==================== -->
            <aside class="col-lg-3 d-none d-lg-block">
                <div class="sr-filter-panel" id="filterPanelDesktop"></div>
            </aside>

            <!-- ==================== SONUÇLAR ==================== -->
            <section class="col-lg-9">
                <!-- Önerilen seçenekler (3 kart) -->
                <div class="sr-suggest-row" id="suggestRow"></div>

                <!-- Uçuş kartları buraya render edilir -->
                <div id="flightList"></div>

                <!-- Boş durum ekranı -->
                <div class="sr-empty d-none" id="emptyState">
                    <i class="bi bi-airplane-engines sr-empty-icon"></i>
                    <h3 class="sr-empty-title">Seçtiğiniz filtrelere uygun uçuş bulunamadı.</h3>
                    <p class="sr-empty-text">Filtreleri gevşeterek daha fazla seçenek görebilirsiniz.</p>
                    <button class="btn btn-sr-primary" id="emptyClearBtn"><i class="bi bi-x-circle me-1"></i>Filtreleri Temizle</button>
                </div>

                <!-- Daha fazla göster -->
                <div class="text-center mt-4">
                    <button class="btn btn-sr-more" id="showMoreBtn">
                        <i class="bi bi-chevron-down me-1"></i>Daha Fazla Uçuş Göster
                        <span id="remainingCount"></span>
                    </button>
                </div>

                <!-- 14. Alt bilgilendirme -->
                <div class="sr-notice">
                    <p class="mb-1"><i class="bi bi-info-circle me-1"></i>Gösterilen fiyatlar kişi başı olup vergi ve hizmet bedellerini içermektedir. Bagaj hakları seçilen paket ve havayoluna göre değişiklik gösterebilir.</p>
                    <p class="mb-0 sr-notice-sub">Fiyatlar belirli aralıklarla güncellenmektedir.</p>
                </div>
            </section>
        </div>
    </main>

    <!-- =========================================================
         FİLTRE OFFCANVAS (mobil)
    ========================================================== -->
    <div class="offcanvas offcanvas-start sr-offcanvas" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="filterOffcanvasLabel"><i class="bi bi-sliders me-1"></i>Filtreler</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body">
            <div class="sr-filter-panel" id="filterPanelMobile"></div>
        </div>
    </div>

    <!-- =========================================================
         10. UÇUŞ SEÇİM MODALI
    ========================================================== -->
    <div class="modal fade" id="selectModal" tabindex="-1" aria-labelledby="selectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sr-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="selectModalLabel">Uçuş Seçiminiz</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body" id="selectModalBody">
                    <!-- JS ile doldurulur -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sr-ghost" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-sr-primary" id="modalContinueBtn">Devam Et</button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         15. FOOTER (kompakt)
    ========================================================== -->
    <footer class="sr-footer" id="footer">
        <div class="container">
            <div class="sr-footer-top">
                <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
                    <span class="sr-logo-mark" aria-hidden="true"><i class="bi bi-send-fill"></i></span>
                    <span class="sr-logo-text text-white">Sky<span class="sr-logo-accent">Route</span></span>
                </a>
                <ul class="sr-footer-links">
                    <li><a href="#">Hakkımızda</a></li>
                    <li><a href="#">Yardım Merkezi</a></li>
                    <li><a href="#">İptal ve İade</a></li>
                    <li><a href="#">Bagaj Kuralları</a></li>
                    <li><a href="#">Gizlilik Politikası</a></li>
                    <li><a href="#">Kullanım Koşulları</a></li>
                </ul>
            </div>
            <hr class="sr-footer-divider">
            <p class="sr-copyright mb-0">© 2026 SkyRoute. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <!-- Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="srToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="srToastBody"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Özel scriptler -->
    <script src="/js/flight-list.js"></script>
</body>
</html>
